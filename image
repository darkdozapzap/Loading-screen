<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Loading Screen</title>
    <style>
        body {
            background-color: #1a1a1a; /* Cor de fundo caso demore para carregar */
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .loading-gif {
            max-width: 500px; /* Ajuste o tamanho máximo conforme necessário */
            width: 100%;
        }
    </style>
</head>
<body>

    <img src="loading.gif" alt="Carregando..." class="loading-gif">

</body>
</html>
